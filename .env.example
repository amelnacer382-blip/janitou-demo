# ==============================================================================
# JANITOU FOOD — Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION CREDENTIALS
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=janitou_user
DB_PASSWORD=janitou_dev_password
DB_NAME=janitou_food_db
DATABASE_URL=postgresql://janitou_user:janitou_dev_password@localhost:5432/janitou_food_db?schema=public

# Storage backend: PostgreSQL when DATABASE_URL is set (default), or "file" for local runs.
JANITOU_STORAGE=postgres

# Backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION=14
BACKUP_ENABLED=1

# Security & Session (Generate secure random keys in production)
JWT_SECRET=dev_jwt_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug

# Require TOTP MFA for ADMIN accounts (0 = optional, 1 = enforced).
# Enable MFA on the admin account before switching this to 1.
JANITOU_MFA_REQUIRED_ADMINS=0

# Real outbound messaging (WhatsApp Cloud API or Twilio SMS)
MESSAGING_ENABLED=1
MESSAGING_CHANNEL=WHATSAPP
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional approved template; leave empty for free-form text messages.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MESSAGING_DEFAULT_COUNTRY_CODE=213
