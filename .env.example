# ==============================================================================
# JANITOU FOOD — Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES OR PRODUCTION CREDENTIALS
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# Application URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=janitou_user
DB_PASSWORD=janitou_dev_password
DB_NAME=janitou_food_db
DATABASE_URL=postgresql://janitou_user:janitou_dev_password@localhost:5432/janitou_food_db?schema=public

# Security & Session (Generate secure random keys in production)
JWT_SECRET=dev_jwt_secret_change_me_in_production
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug
