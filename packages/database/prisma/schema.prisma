// JANITOU FOOD — Prisma Schema Definition
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATIONS_MANAGER
  CHEF_KITCHEN
  PURCHASING_MANAGER
  PACKING_LOGISTICS
  DELIVERY_DRIVER
  CLIENT
}

enum ServiceTime {
  LUNCH
  DINNER
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PLANNED
  IN_PRODUCTION
  PORTIONED_PACKAGED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum ComponentCategory {
  STARTER
  MAIN_COURSE
  SIDE_DISH
  DESSERT
  BEVERAGE
  BREAD
}

enum UnitOfMeasure {
  KG
  G
  L
  ML
  PCS
  PACK
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  RECEIVED
  CANCELLED
}

// ==========================================
// User & Authentication
// ==========================================
model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role         @default(CLIENT)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  customer     Customer?
  driverRuns   DeliveryRun[]

  @@map("users")
}

// ==========================================
// Customers & Dietary Profiles
// ==========================================
model Customer {
  id              String       @id @default(uuid())
  userId          String?      @unique
  user            User?        @relation(fields: [userId], references: [id])
  companyName     String?
  contactName     String
  phone           String
  secondaryPhone  String?
  email           String?
  deliveryAddress String
  wilaya          String?
  commune         String?
  deliveryNotes   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  orders          Order[]
  preferences     CustomerPreference[]

  @@map("customers")
}

model DietaryPreference {
  id          String                 @id @default(uuid())
  code        String                 @unique
  label       String
  description String?
  customers   CustomerPreference[]

  @@map("dietary_preferences")
}

model CustomerPreference {
  customerId          String
  dietaryPreferenceId String

  customer            Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  preference          DietaryPreference @relation(fields: [dietaryPreferenceId], references: [id], onDelete: Cascade)

  @@id([customerId, dietaryPreferenceId])
  @@map("customer_preferences")
}

// ==========================================
// Suppliers & Inventory (Purchasing)
// ==========================================
model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactPerson  String?
  phone          String
  email          String?
  address        String?
  paymentTerms   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  ingredients    Ingredient[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Ingredient {
  id               String               @id @default(uuid())
  name             String               @unique
  unit             UnitOfMeasure
  currentStock     Decimal              @default(0) @db.Decimal(10, 3)
  minimumThreshold Decimal              @default(0) @db.Decimal(10, 3)
  unitCost         Decimal              @default(0) @db.Decimal(10, 2)
  supplierId       String?
  supplier         Supplier?            @relation(fields: [supplierId], references: [id])
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  recipeIngredients RecipeIngredient[]
  purchaseItems     PurchaseOrderItem[]

  @@map("ingredients")
}

// ==========================================
// Recipes & Menus
// ==========================================
model Recipe {
  id                     String             @id @default(uuid())
  name                   String
  category               ComponentCategory
  description            String?
  yieldPortions          Int                @default(1)
  preparationTimeMinutes Int?
  allergens              String[]
  isActive               Boolean            @default(true)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  ingredients            RecipeIngredient[]
  mealPlanStarters       MealPlan[]         @relation("StarterRecipe")
  mealPlanMains          MealPlan[]         @relation("MainCourseRecipe")
  mealPlanSides          MealPlan[]         @relation("SideDishRecipe")
  mealPlanDesserts       MealPlan[]         @relation("DessertRecipe")
  orderItems             OrderItem[]
  productionBatches      ProductionBatch[]

  @@map("recipes")
}

model RecipeIngredient {
  recipeId           String
  ingredientId       String
  quantityPerPortion Decimal       @db.Decimal(10, 4)
  unit               UnitOfMeasure

  recipe             Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient         Ingredient    @relation(fields: [ingredientId], references: [id])

  @@id([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model MealPlan {
  id                 String       @id @default(uuid())
  date               DateTime     @db.Date
  serviceTime        ServiceTime
  starterRecipeId    String?
  mainCourseRecipeId String
  sideDishRecipeId   String?
  dessertRecipeId    String?

  starterRecipe      Recipe?      @relation("StarterRecipe", fields: [starterRecipeId], references: [id])
  mainCourseRecipe   Recipe       @relation("MainCourseRecipe", fields: [mainCourseRecipeId], references: [id])
  sideDishRecipe     Recipe?      @relation("SideDishRecipe", fields: [sideDishRecipeId], references: [id])
  dessertRecipe      Recipe?      @relation("DessertRecipe", fields: [dessertRecipeId], references: [id])

  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([date, serviceTime])
  @@map("meal_plans")
}

// ==========================================
// Orders & Distribution
// ==========================================
model Order {
  id              String       @id @default(uuid())
  orderNumber     String       @unique
  customerId      String
  customer        Customer     @relation(fields: [customerId], references: [id])
  deliveryDate    DateTime     @db.Date
  serviceTime     ServiceTime
  status          OrderStatus  @default(CONFIRMED)
  totalPortions   Int          @default(1)
  deliveryAddress String
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items           OrderItem[]
  deliveryStop    DeliveryStop?

  @@map("orders")
}

model OrderItem {
  id           String      @id @default(uuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recipeId     String
  recipe       Recipe      @relation(fields: [recipeId], references: [id])
  portions     Int         @default(1)
  specialNotes String?

  @@map("order_items")
}

// ==========================================
// Production Planning & Actuals
// ==========================================
model ProductionBatch {
  id                     String      @id @default(uuid())
  productionDate         DateTime    @db.Date
  serviceTime            ServiceTime
  recipeId               String
  recipe                 Recipe      @relation(fields: [recipeId], references: [id])
  plannedPortions        Int
  actualProducedPortions Int?
  status                 String      @default("PLANNED") // PLANNED, IN_PREPARATION, READY
  batchNotes             String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@map("production_batches")
}

// ==========================================
// Purchasing Orders (Raw Material Requisitions)
// ==========================================
model PurchaseOrder {
  id          String              @id @default(uuid())
  poNumber    String              @unique
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  orderDate   DateTime            @default(now())
  status      PurchaseOrderStatus @default(DRAFT)
  totalCost   Decimal?            @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  items       PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  quantity        Decimal       @db.Decimal(10, 3)
  unitCost        Decimal       @db.Decimal(10, 2)

  @@map("purchase_order_items")
}

// ==========================================
// Logistics & Deliveries
// ==========================================
model DeliveryRun {
  id          String         @id @default(uuid())
  runDate     DateTime       @db.Date
  serviceTime ServiceTime
  driverId    String?
  driver      User?          @relation(fields: [driverId], references: [id])
  routeNotes  String?
  status      String         @default("PLANNED") // PLANNED, DISPATCHED, COMPLETED
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  stops       DeliveryStop[]

  @@map("delivery_runs")
}

model DeliveryStop {
  id            String       @id @default(uuid())
  deliveryRunId String
  deliveryRun   DeliveryRun  @relation(fields: [deliveryRunId], references: [id], onDelete: Cascade)
  orderId       String       @unique
  order         Order        @relation(fields: [orderId], references: [id])
  sequence      Int          @default(0)
  deliveryStatus String      @default("PENDING") // PENDING, DELIVERED, FAILED
  deliveredAt   DateTime?
  driverComment String?

  @@map("delivery_stops")
}
